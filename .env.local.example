# MongoDB Atlas connection string
# Format: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/qarinha?retryWrites=true&w=majority
# Get it from: Atlas → Database → Connect → Drivers
MONGODB_URI=

# NextAuth.js — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth credentials
# Get them from: console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# Application type: Web application
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Remote scraper service (Render). If both are set, the Next.js API
# forwards /api/scrape requests to ${SCRAPER_URL}/scrape with the Bearer
# token instead of running Puppeteer locally. Leave blank to fall back
# to in-process Puppeteer (useful for local dev).
# Must include protocol, e.g. https://your-service.onrender.com
SCRAPER_URL=
SCRAPER_TOKEN=