# MongoDB Atlas connection string
# Format: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/qarinha?retryWrites=true&w=majority
# Get it from: Atlas → Database → Connect → Drivers
MONGODB_URI=

# NextAuth.js — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth credentials
# Get them from: console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# Application type: Web application
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub Actions scraper backend (replaces the old Render scraper-service)
# GITHUB_TOKEN: a CLASSIC PAT with the "repo" scope. Fine-grained PATs cannot
#               call POST /repos/{owner}/{repo}/dispatches (it returns
#               403 "Resource not accessible by personal access token").
#               See scraper-service/README.md for the exact setup steps.
# GITHUB_REPO: "owner/repo" of the repo that hosts .github/workflows/scrape.yml.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# Shared secret between the GitHub Actions workflow and the webhook.
# Must match the WEBHOOK_SECRET secret defined on the GitHub repo.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=
